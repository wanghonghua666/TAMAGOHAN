# Firebase Configuration - 请替换为你的实际配置
# 复制此文件为 .env.local 并填入你的Firebase配置信息

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# 示例配置（请替换为你的实际值）:
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB1234567890abcdefghijklmnopqrstuvw
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tamagohan-app.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=tamagohan-app
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tamagohan-app.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456ghi789

# AI食物识别API密钥 (可选 - 用于更精确的食物识别)
# 不设置这些密钥时，系统会使用基于文件名的简单识别

# Clarifai API - 免费额度：每月5000次调用
# 注册地址：https://clarifai.com/
# NEXT_PUBLIC_CLARIFAI_API_KEY=your_clarifai_api_key_here

# Google Vision API - 免费额度：每月1000次调用  
# 注册地址：https://cloud.google.com/vision
# NEXT_PUBLIC_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# 如何获取Firebase配置:
# 1. 访问 https://console.firebase.google.com/
# 2. 创建新项目或选择现有项目
# 3. 点击 "添加应用" -> "Web" 图标
# 4. 注册应用名称，复制配置信息
# 5. 启用以下服务:
#    - Authentication (Email/Password)
#    - Firestore Database (测试模式)
#    - Storage 